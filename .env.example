# ──────────────────────────────────────────────────────
# DJASSA PRO — Configuration d'environnement modèle
# ──────────────────────────────────────────────────────

# Générez une valeur aléatoire forte pour cette variable.
# Exemple : openssl rand -base64 32
JWT_SECRET="remplacez-cette-valeur-par-un-secret-aleatoire"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Base PostgreSQL locale ou distante
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Configuration Supabase éventuelle :
# NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="ne-jamais-publier-cette-cle"
